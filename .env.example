# Pyro API
PYRO_BASE_URL=https://IP:PORT
PYRO_API_KEY=your_api_key_here
PYRO_LOGIN_ID=your_sanchar_mitra_msisdn
PYRO_PASSWORD=your_authentication_password
PYRO_MPIN=your_mpin_for_recharge
PYRO_SECRET_KEY=7416358166xxxxxxxxxx
ADMIN_API_KEY=generate_a_long_random_admin_key

# Oracle DB (BCD table only)
ORACLE_USER=CAF_ADMIN
ORACLE_PASSWORD=your_oracle_password
ORACLE_DSN=hostname:1521/service_name

# Postgres DB — Write endpoint (Primary: 5432)
PG_WRITE_HOST=localhost
PG_WRITE_PORT=5432
PG_WRITE_DATABASE=your_db_name
PG_WRITE_USER=your_pg_user
PG_WRITE_PASSWORD=your_pg_password

# Postgres DB — Read endpoint (Standby / Replica: 5433)
PG_READ_HOST=localhost
PG_READ_PORT=5433
PG_READ_DATABASE=your_db_name
PG_READ_USER=your_pg_read_user
PG_READ_PASSWORD=your_pg_read_password

PG_MIN_CONN=2
PG_MAX_CONN=10

# Deployment
# Share with Pyro: {CALLBACK_BASE_URL}/callback/recharge
CALLBACK_BASE_URL=https://mitra.bsnl.co.in/smpyro

# Batch population schedule (24-hour)
ENABLE_SCHEDULER=true
BATCH_POPULATION_HOUR=7
BATCH_POPULATION_MINUTE=0
ORACLE_BATCH_FETCH_SIZE=500

# Recharge processing
RECHARGE_BATCH_SIZE=500
